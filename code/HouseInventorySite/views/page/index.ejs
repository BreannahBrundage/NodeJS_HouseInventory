<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<title>House Inventory System-COMP 4420</title>
		<meta name="description" content="A simple website for example purposes">
		<meta name="author" content="Comp 2300">
		<!-- Bootstrap CSS Reset -->
		<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css" rel="stylesheet">
	</head>
	<body>
		<!-- Navigation -->
		<nav class="navbar navbar-expand-lg navbar-dark bg-dark static-top">
			  <ul class="navbar-nav">
				<li class="nav-item active">
				  <a class="nav-link" href="/">Home</a>
				</li>
			  </ul>
		</nav>
		
		<!-- Content -->
		<div class="container">
			<h1 class="text-center">House Inventory System</h1>

			<br>

			<!-- Search Bar -->
			 <div>
				<label>Search:</label>
				<input type="text" placeholder="Enter item name">
				<button class="btn btn-primary">Search</button>
			 </div>

			 <br>

			 <!-- Add Buttons -->
			  <div class="text-center">
				<a href="/add-item" class="btn btn-primary">Add Item</a>
				<a href="/add-location" class="btn btn-primary">Add Location</a>
			  </div>

			  <br> 

			  <!-- Locations and Items -->
			   <div class="row">

				<!-- Location Box -->
				 <div class="col-md-6">
					<h3>Locations</h3>
					<div class="border p-3" style="height: 250px;">
						<p>No locations added yet</p>
					</div>
				 </div>

				 <!-- Items Box -->
				  <div class="col-md-6">
					<h3>Items</h3>
					<div class="border p-3" style="height: 250px;">
						<p>No items added yet</p>
				  </div>
			   </div>
            </div>
			   <br>

			   <!-- Botton Page Buttons -->
				<div class="row">
					<div class="col text-center">
						<a href="/view-item" class="btn btn-primary">View Item</a>
					    <a href="/edit-item" class="btn btn-primary">Edit Item</a>
					    <button class="btn btn-primary">Remove Item</button>
					</div>
				</div>
			
		</div>

		<!-- Bootstrap core JavaScript -->
		<script src="/js/jquery.min.js"></script>
		<script src="/js/bootstrap.min.js"></script>
	</body>
</html>

